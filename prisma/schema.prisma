generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model pedido {
  codigo          Int                 @id @unique
  dataAtual       DateTime
  tipo            String
  quantidade      Int
  horaInicio      DateTime?
  horaFinal       DateTime?
  observacoes     String?
  situacao        String
  tempoProduzindo String?
  tempoTotal      String?
  funcionarios    funcionarioPedido[]
  pausas          pausa[]
  maquinarios     pedidoMaquinario[]
  tipoDetalhes    tipoPedido?         @relation("PedidoTipo")
}

model funcionario {
  id      Int                 @id @default(autoincrement())
  nome    String              @unique
  setor   String
  pedidos funcionarioPedido[]
}

model maquinario {
  id      Int                @id @default(autoincrement())
  nome    String             @unique
  pedidos pedidoMaquinario[]
}

model pedidoMaquinario {
  pedidoCodigo Int
  maquinarioId Int
  maquinario   maquinario @relation(fields: [maquinarioId], references: [id])
  pedido       pedido     @relation(fields: [pedidoCodigo], references: [codigo], onDelete: Cascade)

  @@id([pedidoCodigo, maquinarioId])
}

model funcionarioPedido {
  pedidoCodigo  Int
  funcionarioId Int
  funcionario   funcionario @relation(fields: [funcionarioId], references: [id])
  pedido        pedido      @relation(fields: [pedidoCodigo], references: [codigo], onDelete: Cascade)

  @@id([pedidoCodigo, funcionarioId])
}

model pausa {
  id           Int       @id @default(autoincrement())
  pedidoCodigo Int
  horaPausa    DateTime
  horaRetorno  DateTime?
  pedido       pedido    @relation(fields: [pedidoCodigo], references: [codigo], onDelete: Cascade)
}

model tipoPedido {
  id           Int        @id @default(autoincrement())
  pedidoCodigo Int        @unique
  lencol       Lencol?
  metragens    Metragem[]
  camisa       camisa[]
  outrosTipos  outroTipo?
  pedido       pedido     @relation("PedidoTipo", fields: [pedidoCodigo], references: [codigo], onDelete: Cascade)
}

model outroTipo {
  id           Int        @id @default(autoincrement())
  tipoPedidoId Int        @unique
  tipo         String?
  tipoPedido   tipoPedido @relation(fields: [tipoPedidoId], references: [id], onDelete: Cascade)
}

model camisa {
  id           Int        @id @default(autoincrement())
  tipo         String
  tipoPedidoId Int
  tipoPedido   tipoPedido @relation(fields: [tipoPedidoId], references: [id], onDelete: Cascade)
}

model Metragem {
  id           Int        @id @default(autoincrement())
  valor        String
  tipoPedidoId Int
  tipoPedido   tipoPedido @relation(fields: [tipoPedidoId], references: [id], onDelete: Cascade)
}

model Lencol {
  id                Int        @id @default(autoincrement())
  quantidadeLencol  Int
  quantidadeFronha  Int
  quantidadeCortina Int?
  tipoPedidoId      Int        @unique
  tipo              String?
  tipoPedido        tipoPedido @relation(fields: [tipoPedidoId], references: [id], onDelete: Cascade)
}
